      ],
      "thumbnail_asset_id": null
    }
  ],
  "major_factions": [
    {
      "id": "faction-scourge",
      "name": "Scourge",
      "summary": "The undead Scourge raised Scholomance as a training ground for its necromancers, and though the Lich King's fall left it leaderless, its risen legions still hold the crypts beneath Caer Darrow under Darkmaster Gandling.",
      "wiki_url": "https://warcraft.wiki.gg/wiki/Scourge"
    },
    {
      "id": "faction-cult-of-the-damned",
      "name": "Cult of the Damned",
      "summary": "Kel'Thuzad's Cult of the Damned struck the bargain that made Caer Darrow into Scholomance, and the cult remains within its halls, its acolytes still practicing the plaguecraft and necromancy that doomed the Barovs' servants to undeath.",
      "wiki_url": "https://warcraft.wiki.gg/wiki/Cult_of_the_Damned"
    }
  ],
