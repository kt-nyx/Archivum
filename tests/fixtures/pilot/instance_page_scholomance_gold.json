{
  "instance_id": "instance-scholomance",
  "name": "Scholomance",
  "instance_type": "dungeon",
  "parent_zone_id": "zone-western-plaguelands",
  "expansion_context": "retail",
  "wiki_url": "https://warcraft.wiki.gg/wiki/Scholomance",
  "at_a_glance": "Hidden in the ruins of Caer Darrow, Scholomance is a blighted school of necromancy where the Scourge's dark teachings endured long after Lordaeron fell. Its halls remain a symbol of undeath's persistence and the Barov family's ruin.",
  "overview": "Scholomance is the black heart of Caer Darrow, a necromantic school concealed within the old Barov manor and crypts, where ambition, hunger for power, and the fear of death curdled into a lasting curse. Once a noble stronghold restored after the Second War, the estate was twisted when the Barovs struck a bargain with Kel'Thuzad of the Cult of the Damned, trading their legacy for power beyond the grave. In the years that followed, the halls filled with undead tutors, fallen servants, and vile experiments as the school became a proving ground for the Plague of Undeath and the creation of abominations.",
  "history_sections": [
    {
      "heading": "Barovs' Bargain",
      "body": "After its destruction during the Second War, Caer Darrow was restored as the chief seat of House Barov, whose holdings stretched through Brill, Southshore, and Tarren Mill. As the Third War drew near, the Barovs bargained with Kel'Thuzad and the Cult of the Damned to preserve their wealth and dominion beyond death. Beneath the manor, Caer Darrow was secretly transformed into Scholomance, a hidden academy devoted to necromancy and undeath.",
      "source_refs": [
        {
          "source_id": "src-handcrafted-placeholder",
          "locator": "handcrafted-placeholder",
          "revision_id": "handcrafted-placeholder",
          "excerpt_hash": "handcrafted-placeholder"
        }
      ]
    },
    {
      "heading": "School of Necromancy",
      "body": "In the months that followed, Scholomance became a center of plaguecraft, corpse-work, and occult instruction. Cult acolytes studied beneath Caer Darrow while the Barovs' servants were sacrificed to experiments. Before the Scourge had fully emerged in Lordaeron, a plague variant born from Scholomance's work swept through Caer Darrow, leaving no living survivors and binding many victims as ghosts.",
      "source_refs": [
        {
          "source_id": "src-handcrafted-placeholder",
          "locator": "handcrafted-placeholder",
          "revision_id": "handcrafted-placeholder",
          "excerpt_hash": "handcrafted-placeholder"
        }
      ]
    },
    {
      "heading": "Rise of the Dead",
      "body": "After the Scourging of Lordaeron, Scholomance endured as a stronghold of the undead. The Barovs remained within its curse as monstrous remnants of their former house, while Kel'Thuzad's agents and creations haunted the school's depths. Darkmaster Gandling eventually ruled the academy after Kel'Thuzad and Araj the Summoner, as Scholomance decayed into a festering seat of necromantic ruin.",
      "source_refs": [
        {
          "source_id": "src-handcrafted-placeholder",
          "locator": "handcrafted-placeholder",
          "revision_id": "handcrafted-placeholder",
          "excerpt_hash": "handcrafted-placeholder"
        }
      ]
    },
    {
      "heading": "Last Holdout",
      "body": "In the aftermath of the Lich King's fall, the Scourge's command structure fractured, and Darkmaster Gandling turned Scholomance into his own power base. Following the Cataclysm, his failed bid to seize Andorhal forced him back to the academy, where he preserved the last major Scourge holdout west of the Thondroril River. Around the same period, Alexi and Weldon Barov turned against the corruption of their ancestral home, seeking to drive the Scourge from Caer Darrow and end the curse that had consumed their house.",
      "source_refs": [
        {
          "source_id": "src-handcrafted-placeholder",
          "locator": "handcrafted-placeholder",
          "revision_id": "handcrafted-placeholder",
          "excerpt_hash": "handcrafted-placeholder"
        }
      ]
    }
  ],
  "key_characters": [
    {
      "id": "character-darkmaster-gandling",
      "name": "Darkmaster Gandling",
      "summary": "Darkmaster Gandling is Scholomance's sadistic headmaster, a necromancer who rules the school's cursed crypts beneath Caer Darrow. He is the final obstacle to ending the site's blight, and since the Scourge's decline he has clung to control of Scholomance and its undead host.",
      "role": "enemy",
      "wiki_ref": "https://warcraft.wiki.gg/wiki/Darkmaster_Gandling",
      "decision_reason_codes": [
        "llm_selected",
        "adventure_guide_edit",
        "role:enemy:enemy_section"
      ],
      "thumbnail_asset_id": null
    },
    {
      "id": "character-instructor-chillheart",
      "name": "Instructor Chillheart",
      "summary": "Instructor Chillheart is one of Scholomance's foremost undead lecturers, a necromancer whose lingering phylactery preserves her beyond death. She stands against intruders as a grim custodian of the academy's dark teachings, embodying the school's continued devotion to necromantic instruction.",
      "role": "enemy",
      "wiki_ref": "https://warcraft.wiki.gg/wiki/Instructor_Chillheart",
      "decision_reason_codes": [
        "llm_selected",
        "dungeon_scholomance_edit",
        "role:enemy:llm_tiebreaker"
      ],
      "thumbnail_asset_id": null
    },
    {
      "id": "character-jandice-barov",
      "name": "Jandice Barov",
      "summary": "Jandice Barov is one of the Barov family's lingering dead, trapped within Scholomance's necromantic halls and counted among Darkmaster Gandling's puppets. She stands in opposition to those who enter, not by choice but by the school's dark hold, and remains a symbol of the Barovs' corruption.",
      "role": "enemy",
      "wiki_ref": "https://warcraft.wiki.gg/wiki/Jandice_Barov",
      "decision_reason_codes": [
        "llm_selected",
        "dungeon_scholomance_edit",
        "role:enemy:llm_tiebreaker"
      ],
      "thumbnail_asset_id": null
    },
    {
      "id": "character-lilian-voss",
      "name": "Lilian Voss",
      "summary": "Lilian Voss came to Scholomance as a crusader against its necromancers, but Darkmaster Gandling seized and subverted her. Though cast down, she survived the encounter and escaped, a tragic figure whose defiance and corruption haunt the dungeon's legacy.",
      "role": "enemy",
      "wiki_ref": "https://warcraft.wiki.gg/wiki/Lilian_Voss",
      "decision_reason_codes": [
        "llm_selected",
        "dungeon_scholomance_edit",
        "role:enemy:llm_tiebreaker"
      ],
      "thumbnail_asset_id": null
    },
    {
      "id": "character-rattlegore",
      "name": "Rattlegore",
      "summary": "Rattlegore is one of Darkmaster Gandling's puppets within Scholomance, a lingering instrument of the school's necromancy. It stands as a reanimated guardian of the manor, threatening any who enter while serving Gandling's design and the Argent Crusade's investigation into the academy's surviving horrors.",
      "role": "enemy",
      "wiki_ref": "https://warcraft.wiki.gg/wiki/Rattlegore",
      "decision_reason_codes": [
        "llm_selected",
        "dungeon_scholomance_edit",
