{
  "zone_id": "zone-western-plaguelands",
  "name": "Western Plaguelands",
  "wiki_url": "https://warcraft.wiki.gg/wiki/Western_Plaguelands",
  "parent_continent": "eastern-kingdoms",
  "expansion_context": "retail",
  "at_a_glance": "The plague-scarred heartland of fallen Lordaeron, where ruined farms and haunted towns bear the legacy of the Scourge, even as life slowly begins to return to the rotted landscape.",
  "currently": "The Western Plaguelands remain a scarred battleground even as the Argent Crusade and the Cenarion Circle labor to heal the blighted earth. Their efforts unfold under the pressure of renewed war, as Forsaken and Alliance forces press into the zone and clash over Andorhal and a renewed plague threatens their nascent restoration efforts.",
  "history_sections": [
    {
      "heading": "Before the Scourge",
      "body": "Before the Third War, the lands later known as the Western Plaguelands formed a fertile expanse of forests and farmland between Tirisfal Glades and the Eastweald. Hearthglen served as the region’s administrative center, while Andorhal stood as one of Lordaeron’s most important grain distribution hubs. Together, these settlements anchored a prosperous agricultural heartland that supplied much of the kingdom’s northern territories.",
      "source_refs": [
        {
          "source_id": "src-handcrafted-placeholder",
          "locator": "handcrafted-placeholder",
          "revision_id": "handcrafted-placeholder",
          "excerpt_hash": "handcrafted-placeholder"
        }
      ]
    },
    {
      "heading": "Scourging Of Lordaeron",
      "body": "During the Scourging of Lordaeron, Ner’zhul, Kel’Thuzad, and the Cult of the Damned unleashed the Plague of Undeath across the region. Hidden plague cauldrons corrupted the countryside, while Andorhal’s grain network carried the contagion deep into northern Lordaeron. As settlements succumbed to the plague, their dead rose in service to the Lich King. By the war’s end, the Western Plaguelands had been transformed into a blighted wasteland marked by Scourge corruption and widespread ruin.",
      "source_refs": [
        {
          "source_id": "src-handcrafted-placeholder",
          "locator": "handcrafted-placeholder",
          "revision_id": "handcrafted-placeholder",
          "excerpt_hash": "handcrafted-placeholder"
        }
      ]
    },
    {
      "heading": "The Scarlet Crusade",
      "body": "After Lordaeron fell, the Scarlet Crusade seized Hearthglen and established itself as the dominant human power in the region. From fortified strongholds, the Crusade waged a relentless campaign against the undead and any it suspected of corruption. Its zeal gradually hardened into fanaticism, bringing suffering to many of the very people it claimed to protect.",
      "source_refs": [
        {
          "source_id": "src-handcrafted-placeholder",
          "locator": "handcrafted-placeholder",
          "revision_id": "handcrafted-placeholder",
          "excerpt_hash": "handcrafted-placeholder"
        }
      ]
    },
    {
      "heading": "Coming of the Argent Dawn",
      "body": "Several years later, the Argent Dawn launched a concerted effort to break the Scourge’s hold over the Western Plaguelands. The order targeted the plague cauldrons that sustained the region’s corruption and confronted the cauldron lords who oversaw them. With support from both Alliance and Horde forces, the campaign succeeded in weakening the Scourge’s influence and turning its own instruments of plague against the undead.",
      "source_refs": [
        {
          "source_id": "src-handcrafted-placeholder",
          "locator": "handcrafted-placeholder",
          "revision_id": "handcrafted-placeholder",
          "excerpt_hash": "handcrafted-placeholder"
        }
      ]
    },
    {
      "heading": "After the Lich King",
      "body": "Following the war against the Lich King, Tirion Fordring and the Argent Crusade reclaimed Hearthglen and established it as their principal stronghold in Lordaeron. The city became a center for the Crusade’s efforts to secure and restore the surrounding lands. Around the time of the Cataclysm, the Cenarion Circle aided these efforts by cleansing large portions of the lingering plague, allowing vegetation and wildlife to gradually return.",
      "source_refs": [
        {
          "source_id": "src-handcrafted-placeholder",
          "locator": "handcrafted-placeholder",
          "revision_id": "handcrafted-placeholder",
          "excerpt_hash": "handcrafted-placeholder"
        }
      ]
    },
    {
      "heading": "Battle for Andorhal",
      "body": "The region’s recovery remained incomplete, however. Control of Andorhal became the focus of a bitter struggle between Alliance forces and the Forsaken, each seeking to secure the strategic ruins. The Forsaken ultimately prevailed, claiming the city and extinguishing the last significant Scourge presence in the Western Plaguelands. During the Fourth War, the region once again served as a staging ground in the wider conflict between the Alliance and Horde, with Forsaken and Alliance forces bitterly contesting Andorhal itself.",
      "source_refs": [
        {
          "source_id": "src-handcrafted-placeholder",
          "locator": "handcrafted-placeholder",
          "revision_id": "handcrafted-placeholder",
          "excerpt_hash": "handcrafted-placeholder"
        }
      ]
    }
  ],
  "major_factions": [
    {
      "id": "faction-alliance",
      "name": "Alliance",
      "summary": "The Alliance holds territory and serves as a key force in the Western Plaguelands, where its members fight to preserve order and defend the realm against aggressors.",
      "wiki_url": "https://warcraft.wiki.gg/wiki/Alliance"
    },
    {
      "id": "faction-argent-crusade",
      "name": "Argent Crusade",
      "summary": "In Western Plaguelands, the Argent Crusade fights the Scourge and other evil, maintaining a neutral holy-warrior presence to restore the Plaguelands and continue the struggle against undead threats.",
      "wiki_url": "https://warcraft.wiki.gg/wiki/Argent_Crusade"
    },
    {
      "id": "faction-cenarion-circle",
      "name": "Cenarion Circle",
      "summary": "The Cenarion Circle guards and preserves nature’s balance in Western Plaguelands, watching over druids’ practices and maintaining the continuation of life’s cycle.",
      "wiki_url": "https://warcraft.wiki.gg/wiki/Cenarion_Circle"
    },
    {
      "id": "faction-forsaken",
      "name": "Forsaken",
      "summary": "The Forsaken control Andorhal in the Western Plaguelands after driving out the Alliance and ending Scourge presence there. Sylvanas Windrunner and Koltira Deathweaver commanded their forces in that battle.",
      "wiki_url": "https://warcraft.wiki.gg/wiki/Forsaken"
    },
    {
      "id": "faction-cult-of-the-damned",
      "name": "Cult of the Damned",
      "summary": "In Western Plaguelands, the Cult of the Damned operates as Scourge-aligned cultists, spreading plague and serving the Lich King; they also spy in settlements and recruit the living into the Cult or Scourge.",
      "wiki_url": "https://warcraft.wiki.gg/wiki/Cult_of_the_Damned"
    }
  ],
