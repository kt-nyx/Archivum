# Copy to `.env` in the repository root and fill in values.
# Real `.env` is gitignored. Shell / CI variables override these when set.

# --- OpenAI (required for coalesce + draft; fact-check LLM when enabled) ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TEMPERATURE=0.0   # optional; omit for GPT-5.x (many only allow API default). Use for gpt-4* if you want deterministic sampling.
# OPENAI_REASONING_EFFORT=low   # optional Chat Completions knob for reasoning models: none|minimal|low|medium|high|xhigh
# OPENAI_VERBOSITY=low          # optional: low|medium|high
# OPENAI_TIMEOUT_SECONDS=600   # optional HTTP timeout per completion (default 600; raise for very slow models)
# OPENAI_DRAFT_REASONING_EFFORT=low   # optional override for draft substeps (falls back to OPENAI_REASONING_EFFORT)
# OPENAI_DRAFT_VERBOSITY=low          # optional override for draft substeps (falls back to OPENAI_VERBOSITY)
# OPENAI_USE_RESPONSES_API=0          # set to 1 to use Responses API for draft LLM calls (Chat Completions fallback on error)

# WOW_LORE_DRAFT_MODE=staged        # staged (default) or legacy monolithic zone draft
# WOW_LORE_DRAFT_MAX_QUESTLINES_PER_BUCKET=6
# WOW_LORE_DRAFT_MAX_STORY_BEATS=3
# WOW_LORE_DRAFT_MAX_LINK_CARDS=12
# WOW_LORE_DRAFT_MAX_GLOSSARY_TERMS=24

# AI_PROVIDER=openai

# --- Google Custom Search (optional; only if you use --fact-check-web-search) ---
# GOOGLE_API_KEY=
# GOOGLE_CSE_ID=

# --- Run artifact layout (optional) ---
# Parent directory of each ``<run_id>/`` folder (usually ``.../artifacts/runs``).
# Defaults to ``<repo>/artifacts/runs`` so the CLI does not depend on shell cwd.
# WOW_LORE_ARTIFACTS_ROOT=

# --- Dotenv loading (optional) ---
# Set to 0/false/no/off to skip reading `.env` (e.g. subprocess tooling).
# Tests default to WOW_LORE_DOTENV=0 so a local `.env` does not affect pytest.
# WOW_LORE_DOTENV=1
