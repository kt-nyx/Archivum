# Enforce LF line endings repo-wide, both inbound (checkout) and outbound
# (commit). Git normalizes text files to LF in the repo and checks them out with
# LF regardless of core.autocrlf, so hand-authored files and pipeline output
# (pipeline.common.io.write_json) never diverge by line ending. Refactor D-4.
* text=auto eol=lf

# Binary assets must never be line-ending normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.zip binary
*.gz binary
*.tga binary
*.blp binary
*.ttf binary
*.otf binary
*.pdf binary
