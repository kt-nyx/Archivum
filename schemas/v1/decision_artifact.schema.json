{
  "$defs": {
    "IncludeDecision": {
      "enum": [
        "include",
        "exclude",
        "defer"
      ],
      "title": "IncludeDecision",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "algorithm_version": {
      "minLength": 1,
      "title": "Algorithm Version",
      "type": "string"
    },
    "borderline_adjudication": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Borderline Adjudication"
    },
    "features": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "integer"
          },
          {
            "type": "string"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "title": "Features",
      "type": "object"
    },
    "final_decision": {
      "$ref": "#/$defs/IncludeDecision"
    },
    "hard_reject": {
      "default": false,
      "title": "Hard Reject",
      "type": "boolean"
    },
    "hard_reject_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Hard Reject Reasons",
      "type": "array"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Score"
    },
    "subject_id": {
      "minLength": 1,
      "title": "Subject Id",
      "type": "string"
    },
    "subject_type": {
      "minLength": 1,
      "title": "Subject Type",
      "type": "string"
    },
    "thresholds": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Thresholds",
      "type": "object"
    }
  },
  "required": [
    "subject_id",
    "subject_type",
    "run_id",
    "algorithm_version",
    "final_decision"
  ],
  "title": "DecisionArtifact",
  "type": "object"
}
