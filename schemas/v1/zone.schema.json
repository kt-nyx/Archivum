{
  "$defs": {
    "CharacterCard": {
      "properties": {
        "decision_reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Decision Reason Codes",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "role": {
          "default": "uncertain",
          "enum": [
            "enemy",
            "ally",
            "neutral",
            "uncertain"
          ],
          "title": "Role",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "thumbnail_asset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thumbnail Asset Id"
        },
        "wiki_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wiki Ref"
        }
      },
      "required": [
        "id",
        "name",
        "summary"
      ],
      "title": "CharacterCard",
      "type": "object"
    },
    "Faction": {
      "enum": [
        "alliance",
        "horde",
        "shared"
      ],
      "title": "Faction",
      "type": "string"
    },
    "GlossaryLink": {
      "properties": {
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "term_id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Term Id",
          "type": "string"
        },
        "wiki_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wiki Url"
        }
      },
      "required": [
        "term_id"
      ],
      "title": "GlossaryLink",
      "type": "object"
    },
    "IncludeDecision": {
      "enum": [
        "include",
        "exclude",
        "defer"
      ],
      "title": "IncludeDecision",
      "type": "string"
    },
    "InclusionDecision": {
      "description": "Inclusion/exclusion audit object used in candidate filtering.",
      "properties": {
        "criteria_breakdown": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Criteria Breakdown",
          "type": "object"
        },
        "decision_reason": {
          "minLength": 1,
          "title": "Decision Reason",
          "type": "string"
        },
        "include_decision": {
          "$ref": "#/$defs/IncludeDecision"
        },
        "inclusion_score": {
          "maximum": 12,
          "minimum": 0,
          "title": "Inclusion Score",
          "type": "integer"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/SourcePointer"
          },
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "inclusion_score",
        "criteria_breakdown",
        "include_decision",
        "decision_reason"
      ],
      "title": "InclusionDecision",
      "type": "object"
    },
    "InstanceLinkCard": {
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "thumbnail_asset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thumbnail Asset Id"
        }
      },
      "required": [
        "id",
        "name",
        "summary"
      ],
      "title": "InstanceLinkCard",
      "type": "object"
    },
    "LandmarkCard": {
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "significance_tag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Significance Tag"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "thumbnail_asset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thumbnail Asset Id"
        }
      },
      "required": [
        "id",
        "name",
        "summary"
      ],
      "title": "LandmarkCard",
      "type": "object"
    },
    "QuestlineCard": {
      "properties": {
        "dependency_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dependency Note"
        },
        "depends_on_parent_context": {
          "default": false,
          "title": "Depends On Parent Context",
          "type": "boolean"
        },
        "faction": {
          "$ref": "#/$defs/Faction"
        },
        "hook": {
          "minLength": 1,
          "title": "Hook",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "inclusion_decision": {
          "$ref": "#/$defs/InclusionDecision"
        },
        "parallel_arc_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parallel Arc Key"
        },
        "start_anchor": {
          "minLength": 1,
          "title": "Start Anchor",
          "type": "string"
        },
        "story_beats": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Story Beats",
          "type": "array"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "faction",
        "title",
        "hook",
        "start_anchor",
        "inclusion_decision"
      ],
      "title": "QuestlineCard",
      "type": "object"
    },
    "SourceManifestEntry": {
      "properties": {
        "revision_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
