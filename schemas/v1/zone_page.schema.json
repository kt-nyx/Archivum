{
  "$defs": {
    "Faction": {
      "enum": [
        "alliance",
        "horde",
        "shared"
      ],
      "title": "Faction",
      "type": "string"
    },
    "FactionCard": {
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "wiki_url": {
          "minLength": 1,
          "title": "Wiki Url",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "summary",
        "wiki_url"
      ],
      "title": "FactionCard",
      "type": "object"
    },
    "GlossaryLink": {
      "properties": {
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "term_id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Term Id",
          "type": "string"
        },
        "wiki_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wiki Url"
        }
      },
      "required": [
        "term_id"
      ],
      "title": "GlossaryLink",
      "type": "object"
    },
    "HistorySection": {
      "properties": {
        "body": {
          "minLength": 1,
          "title": "Body",
          "type": "string"
        },
        "heading": {
          "minLength": 1,
          "title": "Heading",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/SourcePointer"
          },
          "title": "Source Refs",
          "type": "array"
