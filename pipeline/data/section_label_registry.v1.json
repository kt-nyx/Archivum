{
  "version": 1,
  "_status": "Active. Top-level-type + parent-inheritance model. Regenerate the harvest via scripts.harvest_section_labels; classify only NEW recurring top-level types.",
  "_model": "Enumerate recurring TOP-LEVEL section types only. A block is classified by its own label; on a miss the consumer falls back to the parent (top-level ancestor) section's class; on a further miss it defaults to 'meta' (exclude from lore). Nested subsections (expansion timelines, event sections, faction subgroups, cultural facets) are intentionally NOT listed — they inherit. This removes the open, unmaintainable tail and eliminates substring false-positives (e.g. 'Crimson legion' inherits roster from 'Organization', not narrative from 'legion').",
  "_doc": "slug = slugify(heading,'_'); the pipeline's raw_section_role appends '_edit' (HTML edit-link artifact) — a lookup strips a trailing '_edit'. _evidence is from the whole-game harvest (scripts.harvest_section_labels).",
  "_pilot_bias_note": "Top-level types derived from a 6,047-page whole-game random sample plus the faction/character page trees (Forsaken, Scarlet Crusade, Lilian Voss). Expansion tokens are all current WoW expansions incl. announced (Midnight); append the next on release. Context-dependent labels (battles/horde/classes/letter) are deliberately omitted so parent inheritance resolves them per page.",
  "content_classes": {
    "narrative": "in-universe lore prose; ADMIT to lore pools (character/faction/history)",
    "roster": "structural membership/creature/object lists; structural presence, not prose",
    "geography": "place/geography prose+lists; geography_input",
    "gameplay": "mechanics (abilities/loot/quests/rewards/strategy); EXCLUDE from lore prose",
    "meta": "editorial/out-of-universe apparatus (refs, changelog, gallery, tooltip, trivia); EXCLUDE. (No separate 'chrome' class: true site chrome never appears as a heading.)",
    "non_canon": "RPG/novel-derived; EXCLUDE from canon (canon=false)"
  },
  "fallback": "classify by label; else by parent (top-level ancestor) section's class; else default content_class=meta (exclude from lore prose).",
  "prefix_rules": {
    "in_the_rpg": {
      "content_class": "non_canon",
      "canon": false
    }
  },
