      },
      {
        "part": 2,
        "title": "The uneasy calm",
        "summary": "Faction-split mid-campaign at Andorhal after the first battle; ends with Combat Training before players leave for restoration content."
      },
      {
        "part": 3,
        "title": "The mending of the Plaguelands",
        "summary": "Mender's Stead restoration arc with Argent Crusade and Cenarion Circle."
      },
      {
        "part": 4,
        "title": "Living in the Plaguelands",
        "summary": "Northridge lumber mill / local reconstruction side content (pilot-excluded as a major card)."
      },
      {
        "part": 5,
        "title": "Hearthglen",
        "summary": "Tirion Fordring audience and Fordring legacy investigation at reclaimed Hearthglen."
      },
      {
        "part": 6,
        "title": "The renewed plague",
        "summary": "Del Gahrron / Gahrron's Withering cauldron investigation (pilot-excluded as separate major card; overlaps Part 3 thematically)."
      },
      {
        "part": 7,
        "title": "The battle resumes",
        "summary": "Return to Andorhal for the faction finale; Forsaken win, Alliance loses (Alas, Andorhal / The Reckoning)."
      }
    ]
