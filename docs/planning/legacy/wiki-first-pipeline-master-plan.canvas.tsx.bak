  Text,
  TodoListCard,
} from "cursor/canvas";

const SLICES = [
  {
    id: "slice-1",
    content: "Slice 1 — Evidence scoping + storyline HTML parser + quest graph v3",
    status: "pending" as const,
  },
  {
    id: "slice-2",
    content: "Slice 2 — Quest traversal, lore extraction, questline card synthesis",
    status: "pending" as const,
  },
  {
    id: "slice-3",
    content: "Slice 3 — Zone prose workers (at-a-glance, currently, history)",
    status: "pending" as const,
  },
  {
    id: "slice-4",
    content: "Slice 4 — Faction scoring, ranking, zone-role summaries",
    status: "pending" as const,
  },
  {
    id: "slice-5",
    content: "Slice 5 — Location guards, relevance gates, card quality",
    status: "pending" as const,
  },
  {
    id: "slice-6",
    content: "Slice 6 — Instance parity (LLM workers, bosses, traverse)",
    status: "pending" as const,
  },
  {
    id: "slice-7",
    content: "Slice 7 — Dynamic glossary generation + linker + wiki URLs on refs",
    status: "pending" as const,
  },
  {
    id: "slice-8",
    content: "Slice 8 — Provenance anchors, validation hardening, stub removal",
    status: "pending" as const,
  },
];

export default function WikiFirstPipelineMasterPlan() {
  return (
    <Stack gap={16}>
      <H1>Wiki-First Pipeline — Master Implementation Plan</H1>
      <Text tone="secondary">
        Reference blueprint for slice-by-slice implementation. Western Plaguelands + Scholomance is the proof-of-concept
        run (run-western-plaguelands); all rules must generalize to any zone. Previous starter canvas backed up to{" "}
        docs/planning/archive/wow-lore-compendium-starter-plan.canvas.tsx.bak
      </Text>

      <Row gap={12}>
        <Stat label="Execution model" value="One slice at a time" tone="accent" />
        <Stat label="Pilot run" value="run-western-plaguelands" tone="success" />
        <Stat label="Active slices" value="8 gated" tone="success" />
        <Stat label="Anti-stub policy" value="Hard acceptance gates" tone="accent" />
      </Row>

      <Callout tone="warning" title="Why this plan exists">
        <Text>
          The wiki-first path runs end-to-end but many features are partial or stubbed: quest graph treats geography as
          quests, evidence pools cross-contaminate auxiliary pages, instance drafting skips LLM synthesis, glossary uses a
          static dictionary, and semantic checks pass broken output. This plan replaces mega-sessions with gated slices
          that must pass acceptance before the next slice starts.
        </Text>
      </Callout>

      <Divider />

      <H2>Operating rules (anti-stub)</H2>
      <Table
        headers={["Rule", "Requirement"]}
        rows={[
          [
            "One active slice",
            "Only one slice in progress. No parallel slice work until current slice acceptance passes.",
          ],
          [
            "Acceptance before advance",
            "Each slice has automated checks + WPL rerun. Old broken behaviour must fail tests.",
          ],
          [
            "No placeholder outputs",
            "Forbidden: empty arrays passed as done, regex garbage, raw wiki passthrough labeled synthesis, generic filler sentences.",
          ],
          [
            "Seed vs auxiliary",
            "Zone seed snapshot (no auxiliary_role) is the default source for zone identity/history; auxiliary pages are scoped by role.",
          ],
          [
            "Generalize first",
            "Every rule must work for late-expansion-only zones, classic zones, and sparse wiki pages — not WPL-only hacks.",
          ],
          [
            "Plan session scope",
            "30–45 min planning per slice only when a design fork exists; otherwise implement from this doc.",
          ],
        ]}
      />

      <TodoListCard todos={SLICES} defaultExpanded />

      <Divider />
      <H2>Slice roadmap (summary)</H2>
      <Table
        headers={["Slice", "Workstreams", "Primary deliverables", "Blocks"]}
        rows={[
          [
            "1",
            "W1, W3",
            "Scoped evidence pools; storyline HTML parser; zone_quest_graph_v3; denylist",
            "Everything",
          ],
          ["2", "W4, W5", "Quest traverse; lore extract; cluster questline cards", "Currently, quest section"],
          ["3", "W2", "at-a-glance / currently / history workers + prompts", "Zone prose quality"],
          ["4", "W6", "Faction zone-significance scoring + ranked cards", "Major factions section"],
          ["5", "W7", "Location denylist, relevance, no defer padding", "Landmarks section"],
          ["6", "W8", "Instance LLM workers, boss parse, instance_lore traverse", "Scholomance page"],
          ["7", "W9", "Run-scoped glossary terms; linker; wiki_url on refs", "Click-to-wiki UX"],
          ["8", "W10, W11", "Provenance anchors; validation; remove remaining stubs", "Release quality"],
        ]}
      />

      <Divider />
      <H2>Root-cause diagnosis (WPL run)</H2>
      <Table
        headers={["Symptom", "Root cause", "Fix slice"]}
        rows={[
          [
            "At-a-glance lists locations, too long",
            "992-item pool merges all auxiliary other snippets; 80-word present-tense prompt",
            "1 + 3",
          ],
          [
            "Currently mentions EPL, reputation",
            "Pool includes wrong quest pages + achievement text; no zone filter",
            "1 + 2 + 3",
          ],
          [
            "History present tense, cut off at Tirion",
            "max_sections=4; no past-tense rule; no dynamic cap",
            "3",
          ],
          [
            "Questlines = Lordaeron, Stranglethorn…",
            "_is_quest_link accepts all wiki links; storyline text extractor drops quest table HTML",
            "1 + 2",
          ],
          [
            "Undercity, Ironforge, ADP as locations",
            "Weak typing; defer soft-fill; traverse fetched meta pages",
            "5",
          ],
          [
            "Scholomance at-a-glance = boss name dump",
            "build_instance_page has no LLM workers",
            "6",
          ],
          [
            "Sparse glossary, no wiki links on draft refs",
            "Static dictionary/glossary_aliases.v1.json only",
            "7",
          ],
          [
            "Ironforge provenance spam; empty instance provenance",
            "Paragraph enumeration; instance link pool empty",
            "8",
          ],
        ]}
      />

      <Divider />
      <H2>Content section contracts (target behaviour)</H2>
      <Table
        headers={["Section", "Purpose", "Voice / tense", "Must exclude", "Evidence source priority"]}
        rows={[
          [
            "at_a_glance",
            "1–2 sentence historical identity caption (card/subtitle)",
            "Neutral; historical facts OK",
            "Locations, characters, geography, faction lists",
            "Zone seed history digest (full arc) → caption LLM; max ~40 words",
          ],
          [
            "currently",
            "What is happening in-zone now (in-universe)",
            "Present tense",
            "Adjacent zones, reputation, achievements, player meta",
            "Retail expansion sections on seed → quest clusters → faction profiles",
          ],
          [
            "history_sections",
            "Chronological era/event arcs",
            "Strict past tense",
            "Present-tense framing of old events",
            "Zone seed history blocks only; dynamic 3–8 sections",
          ],
          [
            "major_factions",
            "Who matters here and their zone role",
            "Present for current role; past for defunct leadership",
            "Generic faction wiki ledes without zone tie",
            "faction_profile aux + zone seed + quest cluster bindings",
          ],
          [
            "major_questlines",
            "Narrative hooks for significant story clusters",
            "Player-facing hook, not walkthrough",
            "Zone/geography/achievement pages as cards",
            "Quest cluster evidence from traversed quest pages",
          ],
          [
            "location_cards",
            "Notable places inside the zone",
            "Encyclopedic micro-summary",
            "Other zones, dating conventions, factions, capitals",
            "Seed geography/maps links + location_profile when relevant",
          ],
          [
            "instance (page)",
            "Dungeon identity + significance",
            "Same philosophy as zone at-a-glance + overview",
            "Boss name dumps, MoP patch notes as overview",
            "Instance seed + zone seed instance mentions + instance_lore",
          ],
        ]}
      />

      <Divider />
      <H2>Slice details (expand for plan sessions)</H2>

      <CollapsibleSection title="Slice 1 — Evidence scoping + storyline parser + quest graph v3" count={3}>
        <Stack gap={12}>
          <H3>Goals</H3>
          <Text>
            Stop cross-contamination of evidence pools. Parse storyline page HTML for real quest rows with faction icons.
            Emit quest graph v3 with narrative clusters — not a flat link chain of geography pages.
          </Text>
          <H3>Tasks</H3>
          <Table
            headers={["Task", "Module / file", "Detail"]}
            rows={[
              [
                "Evidence pool scoping",
                "pipeline/discovery/enrich.py, pipeline/generate/draft/wiki_first.py",
                "Tag evidence with source_kind: seed | auxiliary + auxiliary_role. Build pools: history_digest (seed history/*_edit), at_a_glance_input, currently_input — never all auxiliary other.",
              ],
              [
                "Store or re-parse storyline HTML",
                "pipeline/ingest/fetch_wiki.py or pipeline/discovery/storyline_html.py (new)",
                "Parse API HTML before strip: h2/h3 sections, li.questlink rows, img faction icons (Alliance_15, Horde_15, Neutral_15, Both_15).",
              ],
              [
                "Quest link classifier",
                "pipeline/discovery/storyline_parser.py, entity_typing.py",
                "Denylist: zones, continents, *_Quests achievements, Category:, File:, Faction meta. Allow only questlink rows + explicit quest URLs.",
              ],
              [
                "Graph v3 artifact",
                "data/discovery/zone_quest_graph_v3.json",
                "Nodes: cluster_id, cluster_title, quest_id, title, faction_binding, order, source_link, level_range.",
              ],
              [
                "Fix storyline target noise",
                "pipeline/discovery/workflow.py",
                "Do not emit /wiki/Faction as storyline target; require _storyline suffix or explicit see-line inference.",
              ],
            ]}
          />
          <H3>Acceptance (automated)</H3>
          <Table
            headers={["Check", "Criterion"]}
            rows={[
              ["at_a_glance pool size", "WPL: under 50 seed snippets, zero auxiliary other"],
              ["graph v3 node titles", "Must not include Lordaeron, Eastern Kingdoms, Hinterlands, *Quests"],
              ["graph v3 quest count", "WPL: at least 5 real quest nodes with faction_binding"],
              ["storyline parse", "Faction icon counts match HTML (Alliance/Horde/Both/Neutral)"],
            ]}
          />
          <H3>Verification commands</H3>
          <Text tone="secondary">
            uv run lore-pipeline run --run-id run-western-plaguelands --fact-check-profile off -v (after slice) · pytest
            tests/test_storyline_parser.py tests/test_traverse_wiki.py (extend)
          </Text>
        </Stack>
      </CollapsibleSection>

      <CollapsibleSection title="Slice 2 — Quest traversal + lore extraction + questline cards" count={3}>
        <Stack gap={12}>
          <H3>Goals</H3>
          <Text>
            Traverse only graph v3 quest URLs. Extract lore-bearing text from quest pages. Synthesize one card per
            narrative cluster (not per quest). Handle hub pages (e.g. The Battle for Andorhal → sub-quests).
          </Text>
          <H3>Tasks</H3>
          <Table
            headers={["Task", "Detail"]}
            rows={[
              [
                "Quest traverse cap",
                "Extend traverse_wiki: fetch auxiliary_role=quest only from v3 nodes; cap ~25/zone; skip denylist.",
              ],
              [
                "Quest lore extractor",
                "New: extract lead/description/objectives narrative; skip rewards, tables, DB links.",
              ],
              [
                "Hub page resolver",
                "If page is disambiguation/hub (multiple quest links, little lore), follow primary sub-quest links once.",
              ],
              [
                "Cluster card draft",
                "wiki_first.py: group by cluster_id; LLM cta_hook from cluster quest evidence; faction from icon majority.",
              ],
              [
                "Bucket by faction",
                "Populate major_questlines_alliance/horde/shared from cluster faction_binding.",
              ],
            ]}
          />
          <H3>Acceptance</H3>
          <Table
            headers={["Check", "Criterion"]}
            rows={[
              ["major_questlines titles", "No zone or continent names; no *Quests achievement"],
              ["WPL cards", "Includes Battle for Andorhal cluster or equivalent; hooks are narrative not zone description"],
              ["traversal report", "No /wiki/Lordaeron as role=quest"],
              ["quest evidence", "Each cluster has at least 1 quest page snippet in evidence"],
            ]}
          />
        </Stack>
      </CollapsibleSection>

      <CollapsibleSection title="Slice 3 — Zone prose workers (at-a-glance, currently, history)" count={3}>
        <Stack gap={12}>
          <H3>At-a-glance (read wide, write narrow)</H3>
          <Table
            headers={["Step", "Spec"]}
            rows={[
              ["Input", "history_digest from ALL zone seed history/expansion blocks, ordered chronologically"],
              ["Optional precompress", "Deterministic bullets or cheap timeline LLM (~150 words max)"],
              ["Output", "1–2 sentences, 35–45 words; full arc including latest era if in digest"],
              ["Prompt bans", "No locations, characters, geography, faction lists"],
            ]}
          />
          <H3>Currently (generalizable fallback ladder)</H3>
          <Table
            headers={["Priority", "Source"]}
            rows={[
              ["1", "Seed expansion-tagged sections (cataclysm_*, battle_for_*, dragonflight_*, etc.)"],
              ["2", "Seed quests_edit prose"],
              ["3", "Quest cluster synthesized summaries (slice 2)"],
              ["4", "Latest available era section if zone is expansion-new"],
              ["Exclude", "Adjacent zone names, reputation, achievement, players, breadcrumb meta"],
            ]}
          />
          <H3>History (dynamic cap)</H3>
          <Table
            headers={["Rule", "Spec"]}
            rows={[
              ["Pool", "Zone seed history + expansion blocks only"],
              ["Cap", "clamp(3, eligible_block_count, 8); bump toward 8 if total history words > 800"],
              ["Prompt", "Past tense only; chronological; event/era headings; cover through latest wiki era"],
            ]}
          />
          <H3>Acceptance</H3>
          <Table
            headers={["Check", "Criterion"]}
            rows={[
              ["at_a_glance words", "≤ 45; no Caer Darrow/Scholomance list pattern"],
              ["at_a_glance arc", "Mentions recovery/Cataclysm or latest era for WPL"],
              ["currently", "No Eastern Plaguelands; no reputation; present tense in-universe"],
              ["history", "≥ 4 sections for WPL; past tense; last section post-Cata or BfA"],
            ]}
          />
        </Stack>
      </CollapsibleSection>

      <CollapsibleSection title="Slice 4 — Factions" count={2}>
        <Stack gap={12}>
          <Text>
            Candidates from faction_profile snapshots + seed mentions. Score zone significance. Rank dynamically (2–6).
            Alliance/Horde need conflict/plot boost (e.g. Andorhal) — not auto-included from generic presence.
          </Text>
          <Table
            headers={["Signal", "Weight"]}
            rows={[
              ["Mention in seed quests_edit / retail history", "High"],
              ["Quest cluster faction_binding", "High"],
              ["Dedicated faction_profile fetched", "Medium"],
              ["Generic faction page lede only", "Low / exclude"],
              ["Alliance/Horde default", "Low unless conflict score threshold met"],
            ]}
          />
          <H3>Acceptance</H3>
          <Text tone="secondary">
            WPL: Argent Crusade + Cenarion Circle rank high; Scarlet summary must not imply Taelan currently leads WPL;
            Horde included if Andorhal conflict evidenced; summaries complete sentences not truncated mid-clause.
          </Text>
        </Stack>
      </CollapsibleSection>

      <CollapsibleSection title="Slice 5 — Locations" count={2}>
        <Stack gap={12}>
          <Table
            headers={["Guard", "Action"]}
            rows={[
              ["Denylist", "ADP/BDP, dating conventions, capitals outside zone, factions, adjacent zones, NPC names"],
              ["Defer padding", "Remove or cap at 0–1; include-only by default"],
              ["Zone relevance", "location_profile must mention zone name or seed subregion"],
              ["Source preference", "Prefer maps_subregions, geography_edit, history_edit links from seed"],
              ["Traverse", "Do not fetch denylisted location_profile targets"],
            ]}
          />
          <H3>Acceptance</H3>
          <Text tone="secondary">
            WPL cards: Andorhal, Hearthglen, Cinderhome OK. Must NOT include Undercity, Ironforge, ADP, Scourge as
            location.
          </Text>
        </Stack>
      </CollapsibleSection>

      <CollapsibleSection title="Slice 6 — Instance parity" count={2}>
        <Stack gap={12}>
          <Table
            headers={["Task", "Spec"]}
            rows={[
              ["LLM workers", "Wire build_instance_page through synthesize_at_a_glance + overview + history workers"],
              ["Boss list", "Parse encounter/boss section from HTML — replace regex key_enemies"],
              ["Traverse", "instance_lore auxiliary if discovery emits; else seed + zone geography"],
              ["Remove stubs", "Drop _sized_summary padding; no boss-name at_a_glance"],
            ]}
          />
          <H3>Acceptance</H3>
          <Text tone="secondary">
            Scholomance at_a_glance: prose hook about necromancy school; overview: significance not patch notes; key_enemies
            real boss names (Gandling, etc.) not regex fragments.
          </Text>
        </Stack>
      </CollapsibleSection>

      <CollapsibleSection title="Slice 7 — Dynamic glossary" count={2}>
        <Stack gap={12}>
          <Text>
            Replace static dictionary dependency for pipeline runs. Generate run-scoped terms from draft entities +
            evidence. Linker matches run aliases. Each glossary_refs entry includes term_id, label, wiki_url.
          </Text>
          <Table
            headers={["Artifact", "Content"]}
            rows={[
              ["data/glossary/run_terms.jsonl", "term_id, label, wiki_url, category, aliases[]"],
              ["linker input", "Run dictionary first; static glossary_aliases.v1.json tests-only fallback"],
              ["bundle output", "lookup/glossary_refs.json with wiki_url per term"],
            ]}
          />
          <H3>Acceptance</H3>
          <Text tone="secondary">
            WPL: more than 7 terms; refs include wiki_url; terms cover factions/locations/zone name at minimum; no
            dependency on pre-seeded pilot dictionary for new runs.
          </Text>
        </Stack>
      </CollapsibleSection>

      <CollapsibleSection title="Slice 8 — Provenance, validation, stub removal" count={3}>
        <Stack gap={12}>
          <H3>Provenance anchor model</H3>
          <Text>
            One pointer per synthesized field/card: source_id + section_role + excerpt_hash of snippet actually used. Not
            full auxiliary page paragraph enumeration.
          </Text>
          <Table
            headers={["Fix", "Detail"]}
            rows={[
              ["instances provenance", "Populate when instance link summary synthesized"],
              ["glossary provenance", "Section where alias matched"],
              ["card pollution cap", "Warn/fail if pointers per card > 3"],
            ]}
          />
          <H3>Stub removal checklist</H3>
          <Table
            headers={["Stub", "Action"]}
            rows={[
              ["glossary_refs: [] in draft", "Filled by linker with full refs or moved to post-linker contract"],
              ["parent_continent: unknown", "Infer from seed geography or nullable with validation warn"],
              ["related_quest_chains: []", "Populate from quest clusters or remove from schema if unused"],
              ["Generic faction/quest fallback sentences", "Remove; fail validation if synthesis empty"],
              ["check_pilot_semantics.py", "Expand: quest title denylist, word caps, zone token checks"],
            ]}
          />
          <H3>Release gate for slice 8</H3>
          <Text tone="secondary">
            validate_passed=true for zone + instance on WPL run · semantic script passes · no hard-fail provenance issues
          </Text>
        </Stack>
      </CollapsibleSection>

      <Divider />
      <H2>Workstream index (W1–W11)</H2>
      <Table
        headers={["ID", "Name", "Slice"]}
        rows={[
          ["W1", "Evidence scoping (seed vs auxiliary pools)", "1"],
          ["W2", "Section LLM workers + prompts", "3"],
          ["W3", "Storyline HTML parser + quest graph v3", "1"],
          ["W4", "Quest traverse + lore extraction", "2"],
          ["W5", "Questline cluster card synthesis", "2"],
          ["W6", "Faction zone-significance scoring", "4"],
          ["W7", "Location guards + relevance", "5"],
          ["W8", "Instance LLM + boss parse", "6"],
          ["W9", "Dynamic glossary generation", "7"],
          ["W10", "Provenance anchors + validation", "8"],
          ["W11", "Remove remaining stubs", "8"],
        ]}
      />

      <Divider />
      <H2>Pipeline stage touchpoints</H2>
      <Table
        headers={["Stage", "Changes across slices"]}
        rows={[
          ["ingest / fetch_wiki", "Optional raw HTML retention for storyline parse"],
          ["traverse_wiki", "Quest URLs from v3 only; location denylist; instance_lore"],
          ["discovery / workflow", "Storyline target fix; location typing"],
          ["discovery / storyline_parser", "HTML quest row parse; v3 graph"],
          ["discovery / enrich", "Scoped evidence field_names; glossary candidates"],
          ["draft / wiki_first", "All section builders; instance parity"],
          ["draft / wiki_first_workers", "New prompts: caption, currently, history, cluster hook"],
          ["linker", "Run-scoped dictionary; wiki_url on refs"],
          ["validate / structure", "Zone token checks; word caps; provenance caps"],
          ["scripts/check_pilot_semantics.py", "Per-slice acceptance expansion"],
        ]}
      />

      <Divider />
      <H2>Plan session template (copy per slice)</H2>
      <Callout tone="info" title="Slice planning checklist">
        <Stack gap={8}>
          <Text>1. Read slice section in this canvas + linked workstreams.</Text>
          <Text>2. List design forks only (if any) — max 3 decisions.</Text>
          <Text>3. Write acceptance tests first (pytest + semantic script assertions).</Text>
          <Text>4. Implement slice end-to-end — no TODO stubs merged.</Text>
          <Text>5. Rerun run-western-plaguelands full pipeline.</Text>
          <Text>6. Manual read: at-a-glance, currently, history, questlines, locations, Scholomance.</Text>
          <Text>7. Mark slice completed in TodoList only when all acceptance rows pass.</Text>
        </Stack>
      </Callout>

      <Row gap={8}>
        <Pill tone="accent">Next: Slice 1</Pill>
        <Pill tone="neutral">Pilot: WPL + Scholomance</Pill>
        <Pill tone="success">Backup: docs/planning/archive/</Pill>
      </Row>
    </Stack>
  );
}
