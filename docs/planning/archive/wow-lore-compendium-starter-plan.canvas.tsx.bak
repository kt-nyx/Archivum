import { Callout, Divider, H1, H2, Row, Stack, Stat, Table, Text } from "cursor/canvas";

export default function WowLoreCompendiumStarterPlan() {
  return (
    <Stack gap={16}>
      <H1>WoW Lore Compendium - Living Product Blueprint</H1>
      <Text tone="secondary">
        Source-of-truth baseline for future planning sessions. Focus: strict_original content, concise player context,
        map-driven UX, and a single-zone pilot that proves the full authoring-to-runtime loop.
      </Text>

      <Row gap={12}>
        <Stat label="Experience Goal" value="Player-context lore, not wiki walls" tone="accent" />
        <Stat label="Pilot Package" value="Western Plaguelands + Scholomance" tone="success" />
        <Stat label="Execution Model" value="Data-first with locked quality gates" tone="success" />
        <Stat label="Readiness" value="Implementation planning ready" tone="success" />
      </Row>

      <Callout tone="info" title="Design North Star">
        <Text>
          Build a Blizzard-like lore companion that opens from the world map and quickly answers: what this place is,
          why it matters now, what happened here, and what connected content to explore next.
        </Text>
      </Callout>

      <Divider />

      <H2>How To Use This Blueprint</H2>
      <Callout tone="info" title="Read Order for Fast Onboarding">
        <Text>
          Start with Product Charter and Page System for intent, then read Core Build Contracts for implementation
          requirements, then Governance and Delivery for quality and release enforcement. Use the Pilot Baselines appendix
          as concrete reference data during implementation and evaluation.
        </Text>
      </Callout>

      <H2>Project Spirit and Core Goals</H2>
      <Table
        headers={["Theme", "Intent", "Implementation Meaning"]}
        rows={[
          [
            "player-context first",
            "Prioritize what matters now in active play over encyclopedic completeness.",
            "Short, useful sections with clear narrative hooks and practical relevance.",
          ],
          [
            "blizzard-like presentation",
            "Deliver polished map-driven reading and navigation experience.",
            "Consistent page structures, clear hierarchy, strong cross-linking, and clean UI flow.",
          ],
          [
            "reliable lore synthesis",
            "Use multi-source research while shipping only original rewritten prose.",
            "Strict provenance, anti-verbatim controls, and human editorial gates before release.",
          ],
          [
            "small but real pilot",
            "Prove end-to-end pipeline with one high-quality package first.",
            "Western Plaguelands plus Scholomance package validates workflow before scale-up.",
          ],
        ]}
      />

      <Divider />
      <H2>Part A - Product and Experience Contract</H2>

      <H2>0) Charter and Boundaries</H2>
      <Table
        headers={["Area", "Decision", "Rationale"]}
        rows={[
          [
            "primary user value",
            "Lore context for active play, not encyclopedic completeness.",
            "Players need fast orientation and narrative hooks while in-game.",
          ],
          [
            "content posture",
            "Rewritten summaries only, with section-level provenance metadata.",
            "Supports strict_original and reduces legal exposure.",
          ],
          [
            "runtime data model",
            "All data prebuilt and shipped in addon files (no HTTP at runtime).",
            "WoW addon API constraints require static packaged data.",
          ],
          [
            "v1 non-goals",
            "No full questline wiki pages, no leveling optimization, no massive world coverage.",
            "Keep scope tight for quality, review speed, and iteration.",
          ],
          [
            "future-facing goal",
            "Later add player progress awareness for questline state indicators.",
            "High-value enhancement after stable v1 content pipeline.",
          ],
          [
            "v1 extension scope",
            "Support short sub-zone pages (cities/starter subzones) nested under parent zones.",
            "Examples: Stormwind in Elwynn, Orgrimmar in Durotar, Deathknell in Tirisfal.",
          ],
        ]}
      />

      <H2>1) Page System and Information Architecture</H2>
      <Table
        headers={["Page Type", "Decision", "Core Sections"]}
        rows={[
          [
            "zone",
            "Primary page. Keep concise but rich; include landmarks as a dedicated section.",
            "At-a-glance, Currently, History, Major Questlines (Alliance/Horde/Shared), Major Characters, Instances, Major Landmarks, Glossary",
          ],
          [
            "instance",
            "Primary page. Story setup, significance, history, and player purpose are one narrative section.",
            "Header identity, Story Context and Why You Enter, Key Characters, Zone Backlink (top), Glossary",
          ],
          [
            "character",
            "Secondary minimal page. Keep compact.",
            "Header + summary, short history, glossary",
          ],
          [
            "questline",
            "No standalone page in v1. Represent as structured synopsis cards on zone pages (and optional instance references).",
            "Hook, spoiler-light synopsis, start guidance, optional branch/merge hints",
          ],
          [
            "glossary_term",
            "Reference page with category facets. Independent from referring page context.",
            "Header/summary/category, brief history/major beats, optional related links (later)",
          ],
        ]}
      />

      <Callout tone="info" title="Zone History Presentation Rule">
        <Text>
          Organize history as chronological beats anchored to games/expansions where possible (for example Warcraft 2,
          Cataclysm), with off-screen events inserted at the correct chronology point. This is an editorial guideline,
          not a strict formatting law.
        </Text>
      </Callout>

      <Callout tone="info" title="Pilot Ground-Truth Notes (Western Plaguelands)">
        <Text>
          For the pilot, questline organization follows current Retail/Cataclysm-era zone structure with faction-aware
          storytelling. Zone questline presentation is split into Alliance, Horde, and Shared sections. Hearthglen is
          included as a major landmark seed. Lilian Voss is treated as instance-only unless future evidence supports
          major zone-beat inclusion.
        </Text>
      </Callout>

      <H2>2) Authoring Contract Consolidation</H2>
      <Callout tone="info" title="Authoring Contract Consolidation">
        <Text>
          Page-level must-have content and trimming guidance is enforced by the Schema Contracts, Budget Policies, and
          Editorial Style sections below to avoid duplicated rule definitions.
        </Text>
      </Callout>

      <Divider />
      <H2>Part B - Data and Content Pipeline Contract</H2>

      <H2>3) Proposed Repository Structure</H2>
      <Table
        headers={["Path", "Purpose", "Key Files"]}
        rows={[
          [
            "addon/",
            "In-game runtime addon code only (UI, navigation, rendering, links).",
            "addon/Core.lua, addon/UI/MapEntry.lua, addon/UI/Pages/*.lua, addon/DataLoader.lua",
          ],
          [
            "schemas/v1/",
            "Canonical JSON schema contracts and shared validation constants.",
            "zone.schema.json, instance.schema.json, glossary_term.schema.json, asset.schema.json",
          ],
          [
            "pipeline/ingest/",
            "Source retrieval + normalization from Warcraft Wiki/Wowpedia (+ optional Chronicle notes).",
            "fetch_wiki.py, normalize_source.py, source_manifest.schema.json",
          ],
          [
            "pipeline/coalesce/",
            "Entity resolution and multi-source fact coalescence with confidence scores.",
            "resolve_entities.py, merge_rules.yaml, confidence_model.py",
          ],
          [
            "pipeline/generate/",
            "Extraction and rewritten draft generation under style/budget controls.",
            "extract_facts.py, draft_writer.py, prompts/*.md",
          ],
          [
            "pipeline/validate/",
            "Schema, budget, style, provenance, and anti-verbatim checks.",
            "validate_schema.py, validate_style.py, validate_similarity.py",
          ],
          [
            "review/",
            "Editorial artifacts and round-trip review docs for human edits.",
            "packs/*.md, decisions/*.yaml, redlines/*.json",
          ],
          [
            "build/lua/",
            "Compile canonical content into runtime Lua modules split by package.",
            "compile_to_lua.py, out/zones/*.lua, out/glossary/*.lua",
          ],
          [
            "tests/",
            "Automated pipeline tests plus addon smoke harness/checklists.",
            "schema/*.json, linker/*.json, smoke/zone_pilot_checklist.md, fixtures/pilot/*.json",
          ],
        ]}
      />

      <H2>4) Schema v1 Contracts and Word Budgets</H2>
      <Table
        headers={["Type", "Required Fields", "Optional Fields", "Constraints + Budgets"]}
        rows={[
          [
            "zone",
            "id, slug, name, expansion, at_a_glance, currently, history, major_questlines_alliance, major_questlines_horde, major_questlines_shared, major_characters, instances, major_landmarks, glossary, sources, provenance",
            "map_id, faction_notes, timeline_start, timeline_end, media_assets, editorial_notes, future_player_progress_hooks",
            "id lowercase kebab-case; currently 80-140 words; history 140-400 words as chrono beats; 2-8 major questline cards (spoiler-light, max 100 words each); landmarks 3-8; instances excluded from landmarks list.",
          ],
          [
            "instance",
            "id, slug, name, type, zone_id, identity_header, story_context, key_characters, zone_backlink, glossary, sources, provenance",
            "expansion, wing_count, version_notes, related_factions, media_assets",
            "type in [dungeon, raid, scenario]; story_context combines setup + significance + player purpose (160-320 words); key_characters 2-10 including notable allies when relevant; must link valid zone_id.",
          ],
          [
            "character",
            "id, slug, name, summary, short_history, glossary, sources, provenance",
            "titles, affiliations, media_assets, status_hint",
            "summary 40-100 words; short_history 80-180 words; compact by design with total page budget cap.",
          ],
          [
            "glossary_term",
            "id, slug, label, category, aliases, summary, brief_history, sources, provenance",
            "facets{person|event|artifact|faction|place|concept}, timeline_hint, expansion_tags, ambiguity_notes, related_terms",
            "aliases unique normalized lowercase; summary 35-90 words; brief_history 70-170 words; related_terms optional for v1.",
          ],
          [
            "asset",
            "id, asset_type, title, source_url, license, credit, allowed_use, proof_ref, associated_entity_ids, provenance",
            "caption, crop_hint, locale, internal_notes",
            "asset_type in [image, icon, model_ref]; allowed_use boolean + reason; no asset accepted without license + proof_ref.",
          ],
        ]}
      />

      <H2>4b) Starting Generation Budgets (Pilot Defaults)</H2>
      <Table
        headers={["Section", "Target / Min / Max", "Validation Mode"]}
        rows={[
          ["zone.at_a_glance", "35 / 20 / 60 words", "warn"],
          ["zone.currently", "110 / 80 / 140 words", "hard-fail"],
          ["zone.history", "220 / 140 / 400 words", "hard-fail"],
          ["zone.major_questlines_{alliance|horde|shared}.card", "70 / 45 / 100 words", "hard-fail"],
          ["zone.major_questlines_total", "2-6 cards across all faction buckets, <= 480 total words", "hard-fail"],
          ["zone.major_characters.card", "28 / 18 / 45 words", "warn"],
          ["zone.instances.card", "30 / 18 / 50 words", "warn"],
          ["zone.major_landmarks.card", "32 / 20 / 50 words", "warn"],
          ["instance.identity_header", "25 / 10 / 45 words", "warn"],
          ["instance.story_context", "230 / 170 / 320 words", "hard-fail"],
          ["instance.key_characters.card", "30 / 18 / 50 words", "warn"],
          ["character.summary", "70 / 45 / 100 words", "hard-fail"],
          ["character.short_history", "110 / 70 / 160 words", "hard-fail"],
          ["character.page_total", "<= 200 words", "hard-fail"],
          ["glossary.summary", "60 / 35 / 90 words", "hard-fail"],
          ["glossary.brief_history", "115 / 70 / 170 words", "hard-fail"],
        ]}
      />

      <Callout tone="info" title="Budget Policy">
        <Text>
          Hard-fail sections block compile until fixed or explicitly overridden with decision_reason. Warn sections are
          allowed in pilot builds but must appear in review diagnostics.
        </Text>
      </Callout>

      <H2>4c) Questline Card Contract (Faction-Aware)</H2>
      <Table
        headers={["Field", "Purpose", "Notes"]}
        rows={[
          ["title", "Card title shown to player", "Should be readable without prior lore context"],
          ["hook", "Spoiler-light synopsis", "Faction perspective wording required for faction-specific cards"],
          ["start_anchor", "Where the player starts this arc", "Named hub, NPC, or breadcrumb identifier"],
          ["story_beats", "Optional short beat bullets", "Keep concise; max 3 beats in v1"],
          ["parallel_arc_key", "Links allied/horde mirror arcs", "Use when same macro arc is told from both factions"],
          ["faction", "Rendering bucket selector", "enum(alliance|horde|shared)"],
        ]}
      />

      <H2>4d) Schema Example Payloads (Pilot Contract)</H2>
      <Callout tone="info" title="Purpose of Example Payloads">
        <Text>
          These examples are implementation contracts for v1. Validators, generators, review export, and runtime UI
          should treat these shapes as canonical unless a later schema revision is approved.
        </Text>
      </Callout>

      <Table
        headers={["zone field", "example value", "notes"]}
        rows={[
          ["id", "zone-western-plaguelands", "stable canonical id"],
          ["slug", "western-plaguelands", "kebab-case"],
          ["name", "Western Plaguelands", "display name"],
          ["expansion", "cataclysm-state", "content framing for Retail zone"],
          ["at_a_glance", "Once Lordaeron's grain heartland, now a partially reclaimed war-scarred frontier.", "20-60 words"],
          ["currently", "The land is healing under Argent and Cenarion influence, but Andorhal and nearby sites remain conflict-scarred.", "80-140 words"],
          ["history", "Chronology beats from pre-Third War farmland through Cataclysm reclamation and Andorhal outcome.", "140-400 words"],
          ["major_questlines_alliance", "[{...card}]", "array of questline cards"],
          ["major_questlines_horde", "[{...card}]", "array of questline cards"],
          ["major_questlines_shared", "[{...card}]", "array of questline cards"],
          ["major_characters", "[{id:'character-thassarian', summary:'...'}]", "3-6 cards in pilot"],
          ["instances", "[{id:'instance-scholomance', summary:'...'}]", "linked instance cards"],
          ["major_landmarks", "[{id:'landmark-hearthglen', summary:'...'}]", "3-8 cards; no instances"],
          ["glossary", "[{term_id:'term-scourge'},{term_id:'term-andorhal'}]", "8-20 linked terms"],
          ["sources", "[{source_id:'src-wiki-wpl', url:'...'}]", "entity-level sources"],
          ["provenance", "{currently:[...], history:[...], cards:{...}}", "section/card-level source mapping"],
        ]}
      />

      <Table
        headers={["instance field", "example value", "notes"]}
        rows={[
          ["id", "instance-scholomance", "stable canonical id"],
          ["slug", "scholomance", "kebab-case"],
          ["name", "Scholomance", "display name"],
          ["type", "dungeon", "enum(dungeon|raid|scenario)"],
          ["zone_id", "zone-western-plaguelands", "must resolve to existing zone id"],
          ["identity_header", "School of necromancy beneath Caer Darrow.", "10-45 words"],
          ["story_context", "Covers origin, significance, and why players enter now.", "170-320 words"],
          ["key_characters", "[{id:'character-darkmaster-gandling', summary:'...'}]", "2-10 cards"],
          ["zone_backlink", "{zone_id:'zone-western-plaguelands', label:'Back to Western Plaguelands'}", "top-page navigation context"],
          ["glossary", "[{term_id:'term-cult-of-the-damned'}]", "5-15 linked terms"],
          ["sources", "[{source_id:'src-wiki-scholomance', url:'...'}]", "entity-level sources"],
          ["provenance", "{story_context:[...], key_characters:{...}}", "section/card-level source mapping"],
        ]}
      />

      <Table
        headers={["character field", "example value", "notes"]}
        rows={[
          ["id", "character-thassarian", "stable canonical id"],
          ["slug", "thassarian", "kebab-case"],
          ["name", "Thassarian", "display name"],
          ["summary", "Alliance death knight commander during the Andorhal campaign.", "45-100 words"],
          ["short_history", "Condensed background plus WPL-relevant role.", "70-160 words"],
          ["glossary", "[{term_id:'term-alliance'},{term_id:'term-andorhal'}]", "3-10 linked terms"],
          ["sources", "[{source_id:'src-wiki-battle-for-andorhal', url:'...'}]", "entity-level sources"],
          ["provenance", "{summary:[...], short_history:[...]}", "section-level source mapping"],
        ]}
      />

      <Table
        headers={["glossary_term field", "example value", "notes"]}
        rows={[
          ["id", "term-cult-of-the-damned", "stable canonical id"],
          ["slug", "cult-of-the-damned", "kebab-case"],
          ["label", "Cult of the Damned", "display label"],
          ["category", "faction", "enum(person|event|artifact|faction|place|concept)"],
          ["aliases", "['the Cult']", "normalized alias array"],
          ["summary", "Necromantic organization that spread plague and built Scourge influence in Lordaeron.", "35-90 words"],
          ["brief_history", "Major origin and involvement beats relevant to WPL and Scholomance.", "70-170 words"],
          ["facets", "{faction:{alignment:'scourge-aligned'}}", "optional category facet object"],
          ["sources", "[{source_id:'src-wiki-cult-of-the-damned', url:'...'}]", "entity-level sources"],
          ["provenance", "{summary:[...], brief_history:[...]}", "section-level source mapping"],
        ]}
      />

      <Table
        headers={["sub-object", "example shape", "notes"]}
        rows={[
          [
            "questline_card",
            "{id:'ql-andorhal-alliance', faction:'alliance', title:'Andorhal War Campaign', hook:'...', start_anchor:'Andorhal', story_beats:['...'], parallel_arc_key:'andorhal-war-core'}",
            "hook spoiler-light; max 100 words",
          ],
          [
            "character_card",
            "{id:'character-koltira-deathweaver', name:'Koltira Deathweaver', thumbnail_asset_id:'asset-koltira-thumb', summary:'...'}",
            "used on zone/instance pages",
          ],
          [
            "landmark_card",
            "{id:'landmark-hearthglen', name:'Hearthglen', thumbnail_asset_id:'asset-hearthglen-thumb', summary:'...', significance_tag:'arg-crusade-base'}",
            "landmarks exclude instances",
          ],
          [
            "instance_link_card",
            "{id:'instance-scholomance', name:'Scholomance', thumbnail_asset_id:'asset-scholomance-thumb', summary:'...'}",
            "zone to instance bridge card",
          ],
          [
            "source_pointer",
            "{source_id:'src-wiki-wpl', locator:'section:History paragraph:2', excerpt_hash:'sha256:...'}",
            "supports provenance and anti-verbatim checks",
          ],
        ]}
      />

      <Callout tone="warning" title="Shared Validation Rules">
        <Text>
          Every section must include provenance pointers to one or more source passages. Validator rejects verbatim
          overlap above threshold, missing source links, budget overflow, unresolved references, and unknown enum values.
        </Text>
      </Callout>

      <H2>5) End-to-End Pipeline Contract</H2>
      <Table
        headers={["Stage", "Input", "Output", "Format"]}
        rows={[
          [
            "ingest",
            "source_manifest.yaml (entity targets + source priorities)",
            "raw source snapshots with revision metadata",
            "Input YAML -> output NDJSON in data/raw/*.ndjson",
          ],
          [
            "coalesce",
            "data/raw/*.ndjson + entity_seed.json",
            "coalesced entity candidates + scored facts",
            "JSON Lines in data/coalesced/*.jsonl",
          ],
          [
            "extract",
            "coalesced facts",
            "normalized fact graph per entity",
            "JSON in data/extracted/{entity_id}.json",
          ],
          [
            "draft",
            "fact graph + style profile + budget config",
            "canonical draft records by schema type",
            "JSON in data/drafts/{zone|instance|character|glossary|asset}/*.json",
          ],
          [
            "validate",
            "draft records + schemas + glossary dictionary",
            "pass/fail report + rule diagnostics + auto-fix hints",
            "JSON report + text summary + metrics snapshot in reports/validate/",
          ],
          [
            "review export",
            "validated drafts",
            "human-edit markdown pack + change manifest + unresolved question list",
            "Markdown in review/packs/*.md + YAML manifest",
          ],
          [
            "human edit",
            "review markdown pack",
            "editor-approved canonical JSON patch + include/exclude rationale notes",
            "JSON patch in review/redlines/*.json",
          ],
          [
            "compile",
            "approved canonical JSON",
            "Lua data modules ready for addon load",
            "Lua files in build/lua/out/**/*.lua",
          ],
          [
            "in-game smoke test",
            "compiled Lua modules + addon runtime",
            "smoke result checklist + bug list + UX notes",
            "Markdown checklist + JSON status in tests/smoke/results/",
          ],
        ]}
      />

      <H2>6) Glossary Auto-Linking Strategy</H2>
      <Table
        headers={["Area", "Rule", "Implementation Contract"]}
        rows={[
          [
            "alias handling",
            "Store canonical term id with normalized aliases and protected exact forms.",
            "dictionary/glossary_aliases.v1.json (term_id, alias, alias_type, case_rule)",
          ],
          [
            "candidate matching",
            "Match longest alias first, then exact word boundary, then safe fuzzy fallback.",
            "linker emits match spans with source alias and score components",
          ],
          [
            "disambiguation",
            "Use local context window plus section-level category preference; contextual denylist for ambiguous generic terms.",
            "rules/disambiguation.v1.yaml with category tie-break map and denylist conditions",
          ],
          [
            "confidence thresholds",
            "auto-link >= 0.87, review queue 0.65-0.86, reject < 0.65",
            "reports/linker_decisions.jsonl stores score + reason per match",
          ],
          [
            "overlink prevention",
            "First occurrence only per section for the same term; density cap 4 links per 100 words in zone/instance narratives.",
            "style checker enforces occurrence cap and density limits",
          ],
          [
            "alias collisions",
            "Apply category tie-break first; if unresolved, send to review queue (no direct auto-link).",
            "collision handler writes review_queue records with candidate terms",
          ],
          [
            "category preference map",
            "Basic map enabled for v1 (history favors event/person/place; glossary page prefers exact category match).",
            "rules/category_preference.v1.yaml",
          ],
          [
            "qa report",
            "Track false positives, false negatives, ambiguous skips, and per-term precision/recall.",
            "reports/glossary_link_qa.md + reports/glossary_link_qa.json",
          ],
        ]}
      />

      <H2>7) Editorial Style Guide (Enforceable)</H2>
      <Table
        headers={["Rule", "Target", "Automated Check"]}
        rows={[
          [
            "Player-first framing",
            "Explain present relevance before deep history.",
            "currently must appear before history; lint order check",
          ],
          [
            "Brevity discipline",
            "Stay within section budgets for every record type.",
            "hard fail on min/max word budget violations",
          ],
          [
            "Actionable context",
            "Questline entries are hooks and synopses, not leveling optimization.",
            "disallow route-optimization language; require start-point guidance for each major questline card",
          ],
          [
            "Neutral canon tone",
            "No fanon speculation; factual voice and clear uncertainty labels.",
            "banned phrase list + uncertainty tag requirement",
          ],
          [
            "No wiki-copy prose",
            "Original rewritten text only.",
            "similarity gate against source passages with threshold cap",
          ],
          [
            "Glossary restraint",
            "Link major concepts, not one-off terms.",
            "max links per 100 words + allowlist-only linking",
          ],
          [
            "Faction-aware questline rendering",
            "Zone questlines are grouped by Alliance, Horde, and Shared blocks.",
            "schema requires faction bucket fields and card.faction enum validation",
          ],
          [
            "Character page minimalism",
            "Character pages stay summary-first and compact.",
            "hard cap on section count and total word budget",
          ],
          [
            "Spoiler-light hooks",
            "Questline cards should intrigue without over-explaining major endings.",
            "flag banned high-spoiler phrases and require hook-style synopsis length",
          ],
        ]}
      />

      <H2>8) Inclusion Scoring Framework (Major Items)</H2>
      <Table
        headers={["Area", "Criteria (score each 0-2)", "Threshold + Rules"]}
        rows={[
          [
            "major questlines (zone)",
            "narrative centrality; presence breadth; named cast significance; consequence weight; instance relevance; player discoverability",
            "include at >= 8/12; exclude filler travel chains; merge branches that are one arc; split arcs with distinct stakes/themes",
          ],
          [
            "major characters (zone)",
            "story function; screen presence; lore leverage; current relevance; cross-link value; recognition value",
            "include at >= 7/12; target 3-6 characters on zone page",
          ],
          [
            "major characters (instance)",
            "story function; screen presence in key beats; lore leverage; current relevance to this version; cross-link value; recognition value",
            "include at >= 8/12; usually include required bosses plus significant allies; optional bosses only if lore-significant",
          ],
          [
            "major landmarks (zone)",
            "lore significance; story utility; distinctiveness; visit relevance; visual legibility; canonical stability",
            "include at >= 8/12; target 3-8 landmarks; instances never appear in landmarks section",
          ],
        ]}
      />

      <Callout tone="warning" title="Scoring and Override Policy">
        <Text>
          Use objective scoring first, then allow editorial override with a required short reason. This prevents missing
          iconic lore anchors while keeping inclusion criteria consistent and auditable.
        </Text>
      </Callout>

      <Table
        headers={["Override Type", "When To Use", "Required Note"]}
        rows={[
          [
            "legacy iconic override",
            "Item is community-recognized and needed for zone identity despite lower current relevance score.",
            "why iconic and why included now",
          ],
          [
            "continuity override",
            "Item is needed to understand linked instance or another included major section.",
            "dependency being preserved",
          ],
          [
            "pilot cap trimming",
            "Too many items pass threshold; retain highest-value items for concise pilot scope.",
            "which items were dropped and why",
          ],
        ]}
      />

      <Table
        headers={["Decision Field", "Purpose", "Format"]}
        rows={[
          ["inclusion_score", "Stores total score for candidate item", "integer"],
          ["criteria_breakdown", "Stores per-criterion scores for auditability", "object of criterion -> 0|1|2"],
          ["include_decision", "Final include/exclude state", "enum(include|exclude)"],
          ["decision_reason", "Concise editorial rationale, especially for overrides", "string"],
          ["source_refs", "Evidence references used to justify scoring", "array of source pointers"],
        ]}
      />

      <Divider />
      <H2>Part D - Governance, Quality, and Delivery Operations</H2>

      <H2>11) Editorial Review and Redline Workflow (Markdown-Only)</H2>
      <Callout tone="info" title="Workflow Intent">
        <Text>
          All human edits happen in markdown review packs. Redlines are parsed into structured changes and applied back
          to canonical JSON. Reason text is both an audit trail and an active instruction signal used by the agent when
          rewriting follow-up drafts.
        </Text>
      </Callout>

      <Table
        headers={["Step", "Input", "Output"]}
        rows={[
          [
            "review export",
            "validated canonical JSON draft",
            "review markdown pack with budgets, scores, provenance, and unresolved questions",
          ],
          [
            "human edit",
            "review markdown pack",
            "redline entries (action + target + reason + status)",
          ],
          [
            "redline compile",
            "review markdown + redline entries",
            "structured JSON patch payload",
          ],
          [
            "agent revise",
            "JSON patch + reasons + policy rules",
            "updated canonical JSON draft and change summary",
          ],
          [
            "re-validate",
            "updated canonical JSON",
            "pass/fail report and final review status",
          ],
        ]}
      />

      <Table
        headers={["Allowed Edit Action", "Meaning", "Reason Text Required"]}
        rows={[
          ["reword", "Improve clarity/tone without changing factual meaning", "optional"],
          ["trim", "Reduce length/repetition", "optional"],
          ["expand", "Add missing context while staying concise", "optional (required if new claim added)"],
          ["reorder", "Reorder beats/cards for chronology and flow", "optional"],
          ["merge", "Combine overlapping cards/sections", "required"],
          ["split", "Divide overloaded card/section into focused units", "required"],
          ["remove", "Delete low-value or redundant content", "required"],
          ["fact_check", "Flag claim for verification/provenance correction", "required"],
          ["retarget_link", "Change glossary/entity link target", "required if semantic target changes"],
          ["defer", "Move item out of current release scope", "required"],
        ]}
      />

      <Table
        headers={["Reason Text Policy", "Rule", "Why"]}
        rows={[
          [
            "definition",
            "A concise one-sentence note: what changed and why now.",
            "Creates clear decision intent for humans and agents.",
          ],
          [
            "mandatory cases",
            "remove, merge, split, fact_check, defer, any score/budget/provenance override, semantic retarget_link",
            "High-impact edits require explicit rationale and auditability.",
          ],
          [
            "agent behavior",
            "Agent must parse reason text and incorporate it into rewrite decisions and prioritization.",
            "Reason text is an instruction signal, not only documentation.",
          ],
          [
            "traceability",
            "Each applied change stores original reason text in change metadata.",
            "Supports QA, rollback analysis, and future iteration.",
          ],
        ]}
      />

      <Table
        headers={["Override Type", "Allowed When", "Mandatory Fields"]}
        rows={[
          [
            "score override",
            "Iconic, continuity, or obvious relevance missed by scoring model",
            "override_type, reason, owner, revisit_by_or_expiry",
          ],
          [
            "budget override",
            "Clarity or chronology requires temporary budget exception",
            "override_type, reason, owner, revisit_by_or_expiry",
          ],
          [
            "provenance override",
            "Temporary source pointer gap with active follow-up task",
            "override_type, reason, owner, follow_up_ticket",
          ],
        ]}
      />

      <Table
        headers={["Entry Final Status", "Meaning", "Compile Eligibility"]}
        rows={[
          ["approved", "Meets content, budget, provenance, and policy rules", "yes"],
          ["approved_with_exceptions", "Accepted with documented overrides", "yes"],
          ["needs_rewrite", "Quality or structure issues require another draft pass", "no"],
          ["needs_fact_check", "Blocked pending claim/source verification", "no"],
          ["deferred", "Intentionally out of current pilot scope", "no"],
          ["blocked", "Cannot proceed due to missing dependency or source", "no"],
        ]}
      />

      <Callout tone="warning" title="Minimum Redline Entry Shape">
        <Text>
          Each redline entry should include: entry_id, target_path, action, reason_text, editor_status, confidence,
          and optional old_text/new_text snippets. This keeps markdown review human-friendly while preserving a strict
          machine-apply contract.
        </Text>
      </Callout>

